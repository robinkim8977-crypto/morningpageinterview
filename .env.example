# 현재 출시 버전은 API 키 없이 동작합니다.
# 나중에 외부 서비스 키가 필요해지면 여기에 변수명만 추가하고 값은 비워두세요.

# Google Analytics 4 측정 ID
# 예: NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 미래좌표 AI 분석 (서버에서만 사용하며 NEXT_PUBLIC_ 접두사를 붙이지 마세요)
OPENAI_API_KEY=
# 비용과 품질의 균형을 위한 기본값. 필요하면 gpt-5.6-sol 또는 gpt-5.6-luna로 변경하세요.
OPENAI_MODEL=gpt-5.6-terra
# 카드사 심사와 실결제·환불 테스트가 끝나기 전에는 운영 환경에서 false로 유지하세요.
FUTURE_COORDINATE_AI_ENABLED=false
# 로컬에서도 실제 결제 검증과 1회 사용 장부를 시험할 때만 true로 설정하세요.
PAYMENT_LEDGER_ENFORCED=false

# Vercel Marketplace의 Upstash Redis 연결 정보 (서버 전용)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 결제번호와 인터뷰 지문을 HMAC 처리하는 별도 비밀키 (openssl rand -hex 32)
PAYMENT_USAGE_HMAC_SECRET=
# 선택사항: 미설정 시 VERCEL_ENV 또는 NODE_ENV를 사용합니다.
PAYMENT_LEDGER_NAMESPACE=

# PortOne V2 결제 연동
# test: 테스트 채널, live: 실연동 채널, disabled: 결제 버튼 비활성
NEXT_PUBLIC_PAYMENT_MODE=disabled
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
# 포트원 콘솔의 V2 API Secret. 브라우저에 노출되는 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
PORTONE_API_SECRET=
