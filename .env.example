# 현재 출시 버전은 API 키 없이 동작합니다.
# 나중에 외부 서비스 키가 필요해지면 여기에 변수명만 추가하고 값은 비워두세요.

# Google Analytics 4 측정 ID
# 예: NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 미래좌표 AI 분석 (서버에서만 사용하며 NEXT_PUBLIC_ 접두사를 붙이지 마세요)
OPENAI_API_KEY=
# 비용과 품질의 균형을 위한 기본값. 필요하면 gpt-5.6-sol 또는 gpt-5.6-luna로 변경하세요.
OPENAI_MODEL=gpt-5.6-terra
# 결제 검증이 구현되기 전에는 운영 환경에서 false로 유지하세요.
FUTURE_COORDINATE_AI_ENABLED=false
